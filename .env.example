# Copy to .env and adjust. .env is gitignored; never commit real values.

# Comma-separated list of origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Where uploaded audio and transcripts are stored.
RECORDINGS_DIR=recordings
DOCUMENTS_DIR=documents

# Audio files accepted by /transcribe (anything ffmpeg can decode) and the size limit.
ALLOWED_AUDIO_EXTENSIONS=.webm,.wav,.mp3,.m4a,.mp4,.aac,.flac,.ogg,.opus,.wma,.aiff,.aif,.mov,.mkv
MAX_UPLOAD_MB=500

# Whisper model size: tiny, base, small, medium, large
WHISPER_MODEL=small

# Speaker diarization (pyannote). The model is gated: accept its terms on
# huggingface.co once and set HF_TOKEN for the first download.
# Intel Macs (requirements-intel-mac.txt): use pyannote/speaker-diarization-3.1
# and also accept the terms of pyannote/segmentation-3.0.
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
HF_TOKEN=
# auto (cuda if available, else cpu), cpu, cuda or mps
DIARIZATION_DEVICE=auto
# Optional hints; leave empty to let the model decide
MIN_SPEAKERS=
MAX_SPEAKERS=

# Ollama server and summarization model
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_NUM_CTX=8192
OLLAMA_TEMPERATURE=0.3
CHUNK_WORDS=2500
